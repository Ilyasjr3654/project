# Provider LLM : ollama pour local gratuit, openai pour API payante.
LLM_PROVIDER=ollama

# Ollama local
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5-coder:7b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# OpenAI API, seulement si LLM_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# RAG Chroma local
CHROMA_DIRECTORY=data/chroma_db
RAG_TOP_K=5
RAG_EXAMPLE_K=2

# Securite et execution SQLite
SQL_DIALECT=sqlite
SQL_ROW_LIMIT=100
SQL_TIMEOUT_SECONDS=5

# simple fonctionne sans LLM, langchain active le pipeline RAG + LLM
DEFAULT_MODE=simple
